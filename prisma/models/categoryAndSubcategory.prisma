enum CategoryType {
  CLEANING
  HANDYMAN_REPAIRS
  MOVING_TRANSPORT
  ELECTRICAL_PLUMBING
  FURNITURE_CARPENTRY
  PAINTING_RENOVATION
  GARDEN_OUTDOOR
  IT_TECH
  PERSONAL_HELP
  EVENTS_TEMP_HELP
  DELIVERY_ERRANDS
  AUTOMOTIVE_HELP
}

enum SubCategory {
  // Cleaning
  HOUSE_CLEANING
  DEEP_CLEANING
  END_OF_TENANCY_CLEANING
  OFFICE_CLEANING
  WINDOW_CLEANING
  CARPET_CLEANING
  AFTER_RENOVATION_CLEANING

  // Handyman / Repairs
  FURNITURE_ASSEMBLY
  MOUNT_TV_SHELVES
  SMALL_REPAIRS
  DRILLING_MOUNTING
  CURTAINS_BLINDS
  DOOR_LOCK_FIXING

  // Moving & Transport
  APARTMENT_MOVING
  FURNITURE_TRANSPORT
  HEAVY_LIFTING
  JUNK_REMOVAL
  VAN_WITH_HELPER

  // Electrical & Plumbing
  ELECTRICAL_INSTALLATION
  SOCKET_LIGHT_FIXING
  LIGHT_FIXING
  PLUMBING_REPAIRS
  TOILET_SINK_INSTALL
  LEAK_FIXING

  // Furniture & Carpentry
  CUSTOM_FURNITURE
  WOODEN_REPAIR
  IKEA_ASSEMBLY
  SHELVING_INSTALLATION

  // Painting & Renovation
  INDOOR_PAINTING
  OUTDOOR_PAINTING
  WALL_REPAIR
  SMALL_RENOVATION_JOBS

  // Garden & Outdoor
  LAWN_MOWING
  HEDGE_TRIMMING
  GARDEN_CLEANUP
  OUTDOOR_MAINTENANCE

  // IT & Tech
  COMPUTER_SETUP
  WIFI_ROUTER_HELP
  TV_SMART_HOME
  SOFTWARE_INSTALLATION
  PHONE_TABLET_HELP

  // Personal Help
  BABYSITTING
  ELDERLY_HELP
  PET_SITTING
  SHOPPING_ASSISTANCE
  PERSONAL_ASSISTANT

  // Events & Temporary Help
  EVENT_HELP
  MOVING_DAY_HELP
  CATERING_ASSISTANT
  DECORATION_SETUP

  // Delivery & Errands
  FOOD_DELIVERY
  DOCUMENT_DELIVERY
  SMALL_ERRANDS

  // Automotive Help
  CAR_WASH
  BATTERY_JUMP
  TIRE_CHANGE
  BASIC_CAR_HELP
}


model Category {
  id            String        @id @default(uuid())
  category      CategoryType  @unique
  subCategories SubCategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
